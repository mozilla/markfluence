# A template for your markfluence credentials file. markfluence credentials-init
# writes that file for you; to write it by hand instead, copy this to
# ~/.config/markfluence/credentials (or to a file you name with --env-file)
# and fill it in. Then chmod 600 the copy: it holds your API token, and
# markfluence warns if anyone else can read or write it.
CONFLUENCE_URL=https://your-org.atlassian.net
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_TOKEN=your-api-token

# Optional. A *scoped* API token, such as one issued to a service account,
# needs it: those must go through Atlassian's api.atlassian.com gateway rather
# than your site domain. A normal personal token works with or without it.
# markfluence credentials-init fills it in; to find yours (it isn't a secret):
#   curl -s https://your-org.atlassian.net/_edge/tenant_info
#CONFLUENCE_CLOUD_ID=
