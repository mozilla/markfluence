  "html": "<h1>Callouts</h1>\n<ac:structured-macro ac:name=\"info\" ac:schema-version=\"1\"><ac:rich-text-body><p>This is a note callout.</p>\n</ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\"><ac:rich-text-body><p>This is a tip callout.</p>\n</ac:rich-text-body></ac:structured-macro><ac:adf-extension><ac:adf-node type=\"panel\"><ac:adf-attribute key=\"panel-type\">note</ac:adf-attribute><ac:adf-content><p>This is an important callout.</p>\n</ac:adf-content></ac:adf-node></ac:adf-extension><ac:structured-macro ac:name=\"note\" ac:schema-version=\"1\"><ac:rich-text-body><p>This is a warning callout.</p>\n</ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name=\"warning\" ac:schema-version=\"1\"><ac:rich-text-body><p>This is a caution callout.</p>\n</ac:rich-text-body></ac:structured-macro>",
